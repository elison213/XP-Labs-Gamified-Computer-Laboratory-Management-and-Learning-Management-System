<Window x:Class="XPLabs.Widget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XPLabs"
        Width="380"
        Height="560"
        MinWidth="340"
        MinHeight="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Topmost="False"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False">
  <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="34"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#1E293B" CornerRadius="12,12,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <DockPanel Margin="10,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="—" Width="28" Height="22" Margin="0,0,4,0" Click="HideButton_Click" ToolTip="Hide to tray"/>
            <Button Content="✕" Width="28" Height="22" Click="HideButton_Click" ToolTip="Hide to tray"/>
          </StackPanel>
          <TextBlock Text="XPLabs" Foreground="#A5B4FC" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8,12,12">
        <StackPanel>
          <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="10">
            <StackPanel>
              <TextBlock x:Name="StatusText" Text="Checking status..." Foreground="#E2E8F0"/>
              <TextBlock x:Name="PcText" Text="PC: -" Foreground="#E2E8F0" Margin="0,6,0,0"/>
              <TextBlock x:Name="UserText" Text="User: -" Foreground="#E2E8F0" Margin="0,4,0,0"/>
              <TextBlock x:Name="SubjectText" Text="Subject: -" Foreground="#E2E8F0" Margin="0,4,0,0"/>
              <TextBlock x:Name="HeartbeatText" Text="Last server time: -" Foreground="#94A3B8" Margin="0,4,0,0"/>
              <TextBlock x:Name="ActivityText" Text="Activity: sampling desktop" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock Text="Messages" Foreground="#A5B4FC" FontWeight="SemiBold"/>
              <ListBox x:Name="MessagesList"
                       MinHeight="120"
                       MaxHeight="180"
                       Margin="0,8,0,0"
                       Background="#111827"
                       BorderBrush="#334155"
                       BorderThickness="1"
                       Foreground="#E2E8F0"
                       FontSize="12"/>
              <TextBox x:Name="ReplyTextBox"
                       Height="52"
                       Margin="0,8,0,0"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       Background="#111827"
                       Foreground="#E2E8F0"
                       BorderBrush="#334155"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="SendReplyButton" Content="Send Reply" Width="90" Height="30" Click="SendReplyButton_Click"/>
                <Button x:Name="RefreshMessagesButton" Content="Refresh" Width="72" Height="30" Margin="8,0,0,0" Click="RefreshMessagesButton_Click"/>
              </StackPanel>
              <TextBlock x:Name="MessagesStatusText" Foreground="#94A3B8" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="OpenSiteButton" Content="Open Website" Width="110" Height="32" Click="OpenSiteButton_Click"/>
            <Button x:Name="RefreshButton" Content="Refresh" Width="80" Height="32" Margin="8,0,0,0" Click="RefreshButton_Click"/>
            <CheckBox x:Name="AlwaysOnTopCheck" Content="On Top" Margin="10,7,0,0" Foreground="#E2E8F0" IsChecked="True" Checked="AlwaysOnTopCheck_Changed" Unchecked="AlwaysOnTopCheck_Changed"/>
          </StackPanel>

          <Border x:Name="AdminBanner" Background="#3F1D1D" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="AdminBannerText" Text="Logs are visible for administrators only." Foreground="#FCA5A5" TextWrapping="Wrap"/>
          </Border>

          <Border x:Name="LogsPanel" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,10,0,0" Visibility="Collapsed">
            <DockPanel MinHeight="120">
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="ExportLogsButton" Content="Export Logs" Width="90" Height="26" Click="ExportLogsButton_Click"/>
                <Button x:Name="CopyErrorsButton" Content="Copy Errors" Width="90" Height="26" Margin="8,0,0,0" Click="CopyErrorsButton_Click"/>
              </StackPanel>
              <TextBox x:Name="LogsTextBox"
                       IsReadOnly="True"
                       FontFamily="Consolas"
                       FontSize="12"
                       Foreground="#E5E7EB"
                       Background="#111827"
                       BorderThickness="0"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto"
                       TextWrapping="NoWrap"
                       AcceptsReturn="True"/>
            </DockPanel>
          </Border>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ToggleLogsButton" Content="Show Logs" Width="92" Height="30" Click="ToggleLogsButton_Click"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
